rules_version = '2';
// Client uploads. Paths are the ones the apps actually write:
//   orders/{orderId}/food_*.jpg                         rider pickup photo
//   slips/riders/{riderUid}/{orderId}_*.jpg             rider slip paid to the shop
//   slips/orders/{orderId}/admin-*.*                    boss/admin settlement slip
//   chats/{orderId}/images/*                            customer, rider, shop chat
//   chats/{uid}/images/parcel_*                         customer parcel photo
//   chats/{orderId}/{file}                              admin/boss chat image
//   slips/customers/{customerUid}/{orderId}/{file}      customer payment proof
//   gp_slips/{merchantUid}/*                            shop GP slip
//   menus/{merchantUid}/*  shops/{merchantUid}/*        menu photo and shop avatar
// Customer payment proof is uploaded under slips/customers/{uid}/{orderId}/.
// Several clients call put(blob) or put(file) with no metadata. The Storage
// SDK then sends application/octet-stream when the Blob type is empty
// (common for a camera blob). A .jpg/.png/... name with that type is still
// an image. Deletes have no request.resource, so they are separate from
// the image check. The order's rider is orders/{id}.riderId == auth.uid.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function adminPath() {
      return /databases/(default)/documents/admins/$(request.auth.uid);
    }

    function riderPath() {
      return /databases/(default)/documents/riders/$(request.auth.uid);
    }

    function authEmail() {
      return request.auth.token.get('email', '');
    }

    function isAdmin() {
      return signedIn() && (
        (
          authEmail() != ''
          && authEmail().lower() in [
            'adminchauatgo@gmail.com',
            'admin@chauatgo.com',
            'chauatgo@gmail.com'
          ]
        )
        || (
          firestore.exists(adminPath())
          && firestore.get(adminPath()).data.role in ['active', 'super']
        )
        || (
          firestore.exists(userPath())
          && firestore.get(userPath()).data.role == 'admin'
          && firestore.get(userPath()).data.get('isPending', false) != true
        )
      );
    }

    function isRiderAccount() {
      return signedIn() && firestore.exists(riderPath());
    }

    function merchantPath() {
      return /databases/(default)/documents/merchants/$(request.auth.uid);
    }

    function isMerchantAccount() {
      return signedIn() && firestore.exists(merchantPath());
    }

    function contentType() {
      return request.resource.contentType == null ? '' : request.resource.contentType;
    }

    function imageTyped() {
      return contentType().matches('image/.*');
    }

    // Full match. request.resource.name is the object path, e.g. orders/id/food_1.jpg.
    function imageNamed() {
      return request.resource.name.lower().matches('.*\\.(jpg|jpeg|png|webp|gif|heic|heif)');
    }

    function untypedImage() {
      return imageNamed()
        && (contentType() == '' || contentType() == 'application/octet-stream');
    }

    function isImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && (imageTyped() || untypedImage());
    }

    function orderPath(orderId) {
      return /databases/(default)/documents/orders/$(orderId);
    }

    function chatPath(chatId) {
      return /databases/(default)/documents/chats/$(chatId);
    }

    function orderFieldIsMe(orderId, field) {
      return firestore.exists(orderPath(orderId))
        && firestore.get(orderPath(orderId)).data.get(field, '') == request.auth.uid;
    }

    function isOrderCustomer(orderId) {
      return signedIn() && orderFieldIsMe(orderId, 'userId');
    }

    function isOrderRider(orderId) {
      return signedIn() && orderFieldIsMe(orderId, 'riderId');
    }

    function isOrderShop(orderId) {
      return signedIn() && orderFieldIsMe(orderId, 'merchantId');
    }

    function orderParty(orderId) {
      return isOrderCustomer(orderId) || isOrderRider(orderId) || isOrderShop(orderId);
    }

    function chatParty(chatId) {
      return signedIn()
        && firestore.exists(chatPath(chatId))
        && (
          firestore.get(chatPath(chatId)).data.get('userId', '') == request.auth.uid
          || firestore.get(chatPath(chatId)).data.get('riderId', '') == request.auth.uid
          || firestore.get(chatPath(chatId)).data.get('merchantId', '') == request.auth.uid
        );
    }

    // chatId is the order id for order chats, or the customer's uid for a
    // parcel photo stored before the order exists.
    function canSeeChatFile(chatId) {
      return signedIn() && (
        request.auth.uid == chatId
        || orderParty(chatId)
        || chatParty(chatId)
        || isAdmin()
      );
    }

    match /chats/{chatId}/images/{fileName} {
      allow read: if canSeeChatFile(chatId);
      allow create, update: if canSeeChatFile(chatId) && isImage();
      allow delete: if canSeeChatFile(chatId);
    }

    match /chats/{chatId}/{fileName} {
      allow read: if isAdmin() || orderParty(chatId) || chatParty(chatId);
      allow create, update: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }

    match /gp_slips/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isImage() && request.auth.uid == uid && isMerchantAccount();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /menus/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isImage() && request.auth.uid == uid && isMerchantAccount();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /shops/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isImage() && request.auth.uid == uid && isMerchantAccount();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Rider payment QR. Only the rider who owns the profile may upload/update it.
    // The download URL is delivered to the customer inside the authorized order chat.
    match /rider_qr/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isImage() && request.auth.uid == uid;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Pickup photo under the rider's own uid. auth.uid is the check.
    // firestore.get is not used, so a missing Storage service-agent grant
    // cannot deny this write.
    match /orders/{orderId}/riders/{uid}/{fileName} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if isImage() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Chat images and pickup photos share this match. A photo at
    // chats/{orderId}/riders/{uid}/food_*.jpg is the same rule as a chat
    // image at chats/{orderId}/riders/{uid}/{timestamp}.jpg. The orders/
    // tree also has a shallower match that calls firestore.get; pickup
    // does not use that path.
    match /chats/{orderId}/riders/{uid}/{fileName} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if isImage() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Any order type, including express whose parcel category is food.
    // The cross-check is orders/{id}.riderId == auth.uid. Status and type
    // are not read. Image means image/* or an image filename with an empty
    // or application/octet-stream type, larger than 0 and at most 5MB.
    match /orders/{orderId}/{fileName} {
      allow read: if signedIn() && (isAdmin() || orderParty(orderId));
      allow create, update: if isImage() && (isOrderRider(orderId) || isAdmin());
      allow delete: if isOrderRider(orderId) || isAdmin();
    }

    match /slips/riders/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isImage() && request.auth.uid == uid;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Customer payment proof is scoped to the customer's own order. The
    // customer may upload/read/delete their proof; the assigned rider,
    // merchant, and admins may read it but cannot overwrite it.
    match /slips/customers/{uid}/{orderId}/{fileName} {
      allow read: if signedIn() && (isAdmin() || orderParty(orderId));
      allow create: if isImage()
        && signedIn()
        && request.auth.uid == uid
        && isOrderCustomer(orderId)
        && resource == null;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == uid
        && isOrderCustomer(orderId);
    }

    match /slips/orders/{orderId}/{fileName} {
      allow read: if signedIn() && (isAdmin() || orderParty(orderId));
      allow create, update: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }
  }
}
