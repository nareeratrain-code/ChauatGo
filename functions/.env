# Soft mode: log App Check on callable functions, do not reject.
# Ship the client first. After App Check metrics show verified requests
# for a day or two, set this to true and redeploy functions only:
#   firebase deploy --only functions --project chauat-go-b9841
# Firestore and Storage Enforce are Console toggles, done after that,
# not by this file. Leave Cloud Messaging unenforced.
# Localhost uses an App Check debug token. Register it in the console.
# Never put that token, or any secret, in this file.
APP_CHECK_ENFORCE=false
