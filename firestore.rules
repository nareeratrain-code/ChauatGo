rules_version = '2';
// ChauatGo — based on console rules v3.8.4 (project chauat-go-b9841).
// Deltas from v3.8.4:
//   * merchants: unauthenticated read only when verified == true (shop list query)
//   * menus: public read (list query is merchantId only; cannot prove parent verified)
//   * orders update: a rider cannot set riderId or status accepted.
//     Acceptance is only the acceptDispatchOffer / claimOpenJob callables.
//   * orders update [E]: merchant may set foodReady + readyAt after rider accepted,
//     without changing status; status becomes ready only while no rider is assigned
//   * orders update [C]: picked_up only after food is ready when the order needs a kitchen.
//     Food photo may be saved without the shop slip. The slip is a later update
//     that keeps status. A kitchen order cannot become on_the_way until that slip exists.
//   * isAdmin also covers boss role active/super, users.role admin (not pending),
//     and the three master emails — a pending admins doc cannot self-promote
//   * placeOverrides: anyone can read; only isAdmin() can write.
//     OSM corrections: hidden / name / lat / lng.
//     Admin-added places: type 'added' plus name, category, tambon, lat, lng.
//   * orders/{orderId}/calls: only that order's customer, rider, or shop
//     (or admin) may read signaling. A participant may create a call as
//     themselves and write offer, answer, and ICE for that call.
//   * orders read: customer, shop, assigned rider, admin/boss, or a verified
//     rider reading an order that has no riderId. Verified-partner food
//     (partnerShop == true) is visible only after the shop has accepted.
//     Non-partner food, ride, express, and shopping stay visible from searching.
//   * orders create: clients cannot set fare or total. createOrder
//     recomputes them. A direct client create is denied (mismatch).
//   * orders update: riders cannot write riderIncome, riderOwe, or riderPaid.
//     completeOrder writes the 80/20 split and food GP.
//   * riders update: totalIncome and totalJobs stay server-owned.
//   * gp_transfers: amount is above 0 and at most ฿100,000, slip under gp_slips/{uid}/.
//   * auto dispatch: riders cannot write dispatch fields, dispatchOffers,
//     or rider_locks. Claiming an order from the client is denied.
//     config/dispatch is admin-write, auth-read.
//   * chats/messages: the order's customer, rider, or shop may read and send
//     even when the chat doc has no userId/riderId (or does not exist yet).
//     A missing chat can be read as "not found" by any signed-in user.
//     Message keys are senderId, senderRole, senderName, text, imageUrl,
//     imagePath, createdAt, systemMessage, plus automated (bool) and
//     automationKey (short string) for rider status notes — no phone fields.
//   * An assigned rider on an on_the_way order may set riderNearCustomerAt,
//     riderNearCustomerChatAt, and riderArrivedCustomerChatAt.
// Every other collection keeps the v3.8.4 access shape.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    // Phone sign-in stores email as null. .lower() on null denies the whole rule.
    function authEmail() {
      return isAuth() && request.auth.token.get('email', '') is string
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    function isMasterEmail() {
      return authEmail() in [
        'adminchauatgo@gmail.com',
        'admin@chauatgo.com',
        'chauatgo@gmail.com'
      ];
    }

    function isBossActive() {
      return isAuth()
        && exists(/databases/$(database)/documents/admins/$(myUid()))
        && get(/databases/$(database)/documents/admins/$(myUid())).data.get('role', '') in ['active', 'super'];
    }

    function isAdminByRole() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && get(/databases/$(database)/documents/users/$(myUid())).data.get('role', '') == 'admin'
        && get(/databases/$(database)/documents/users/$(myUid())).data.get('isPending', false) != true;
    }

    // v3.8.4 named this exists(admins/{uid}). Pending signups must not inherit it.
    function isAdmin() {
      return isMasterEmail() || isBossActive() || isAdminByRole();
    }

    function isMerchant() {
      return isAuth() && exists(/databases/$(database)/documents/merchants/$(myUid()));
    }

    function isRider() {
      return isAuth() && exists(/databases/$(database)/documents/riders/$(myUid()));
    }

    function isRiderByRole() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && get(/databases/$(database)/documents/users/$(myUid())).data.role == 'rider';
    }

    function isRiderActor() {
      return isRider() || isRiderByRole();
    }

    function isVerifiedRider() {
      return isAuth()
        && exists(/databases/$(database)/documents/riders/$(myUid()))
        && get(/databases/$(database)/documents/riders/$(myUid())).data.get('verified', false) == true;
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function changedToTimestamp(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || request.resource.data.get(field, null) is timestamp;
    }
    function changedToString(field, minLen, maxLen) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || isValidString(request.resource.data.get(field, ''), minLen, maxLen);
    }
    function changedToBool(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || request.resource.data.get(field, false) is bool;
    }
    function merchantCreateOk() {
      return request.resource.data.keys().hasOnly([
        'merchantId', 'name', 'category', 'phone', 'email', 'address',
        'openTime', 'closeTime', 'isOpen', 'verified', 'ratingAvg',
        'ratingCount', 'gpStartDate', 'gpPending', 'gpPaid', 'gpConsent',
        'soundSettings', 'createdAt'
      ])
        && request.resource.data.merchantId == myUid()
        && request.resource.data.verified == false
        && request.resource.data.isOpen == false
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.gpPending == 0
        && request.resource.data.gpPaid == 0
        && request.resource.data.gpConsent == true
        && request.resource.data.createdAt is timestamp
        && isValidString(request.resource.data.name, 1, 120)
        && isValidString(request.resource.data.category, 1, 40)
        && isValidString(request.resource.data.phone, 1, 30)
        && isValidString(request.resource.data.email, 3, 200)
        && isValidString(request.resource.data.address, 1, 300)
        && isValidString(request.resource.data.openTime, 1, 10)
        && isValidString(request.resource.data.closeTime, 1, 10)
        && request.resource.data.soundSettings is map;
    }
    function merchantProfileUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'phone', 'email', 'address', 'category', 'openTime', 'closeTime',
        'isOpen', 'lastToggle', 'image', 'imagePath', 'imageUpdatedAt',
        'soundSettings', 'menuCategories'
      ])
        && changedToString('name', 1, 120)
        && changedToString('phone', 0, 30)
        && changedToString('email', 0, 200)
        && changedToString('address', 0, 300)
        && changedToString('category', 0, 40)
        && changedToString('openTime', 0, 10)
        && changedToString('closeTime', 0, 10)
        && changedToString('image', 0, 2000)
        && changedToString('imagePath', 0, 400)
        && changedToBool('isOpen')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['soundSettings'])
          || request.resource.data.soundSettings is map)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['menuCategories'])
          || request.resource.data.menuCategories is list)
        && changedToTimestamp('lastToggle')
        && changedToTimestamp('imageUpdatedAt');
    }
    function cancelFieldsOk(cancelledBy) {
      return request.resource.data.cancelledBy == cancelledBy
        && request.resource.data.cancelledAt is timestamp
        && isValidString(request.resource.data.get('cancelReason', ''), 1, 300);
    }
    function riderProfileUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'lastToggle', 'fcmTokens', 'qrCodeUrl', 'qrCodePath'
      ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in ['active', 'inactive'])
        && changedToTimestamp('lastToggle')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmTokens'])
          || (request.resource.data.fcmTokens is list
            && request.resource.data.fcmTokens.size() <= 10))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['qrCodeUrl'])
          || isValidString(request.resource.data.get('qrCodeUrl', ''), 0, 2000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['qrCodePath'])
          || isValidString(request.resource.data.get('qrCodePath', ''), 0, 400)
            && (request.resource.data.get('qrCodePath', '') == ''
              || request.resource.data.qrCodePath.matches('^rider_qr/' + myUid() + '/[A-Za-z0-9_.-]+$')));
    }
    function gpsWriteOk(riderId) {
      return request.resource.data.keys().hasOnly([
        'riderId', 'name', 'lat', 'lng', 'accuracy', 'geohash', 'online', 'updatedAt'
      ])
        && request.resource.data.riderId == riderId
        && isValidString(request.resource.data.get('name', ''), 0, 120)
        && isValidNumber(request.resource.data.lat, 7.7, 9.5)
        && isValidNumber(request.resource.data.lng, 99.1, 100.5)
        && (!('accuracy' in request.resource.data)
          || request.resource.data.accuracy == null
          || isValidNumber(request.resource.data.accuracy, 0, 10000))
        && isValidString(request.resource.data.get('geohash', ''), 0, 30)
        && request.resource.data.online is bool
        && request.resource.data.updatedAt is timestamp;
    }
    function ratingCreateOk(ratingId) {
      return isAuth()
        && exists(orderPath(ratingId))
        && request.resource.data.keys().hasOnly([
          'orderId', 'userId', 'userName', 'merchantId', 'riderId',
          'merchantRating', 'riderRating', 'comment', 'createdAt'
        ])
        && request.resource.data.orderId == ratingId
        && request.resource.data.userId == myUid()
        && get(orderPath(ratingId)).data.get('userId', '') == myUid()
        && get(orderPath(ratingId)).data.status in ['done', 'delivered']
        && get(orderPath(ratingId)).data.get('rated', false) != true
        && request.resource.data.get('merchantId', '') == get(orderPath(ratingId)).data.get('merchantId', '')
        && request.resource.data.get('riderId', '') == get(orderPath(ratingId)).data.get('riderId', '')
        && isValidString(request.resource.data.get('userName', ''), 1, 120)
        && isValidNumber(request.resource.data.get('merchantRating', 0), 0, 5)
        && isValidNumber(request.resource.data.get('riderRating', 0), 0, 5)
        && isValidString(request.resource.data.get('comment', ''), 0, 1000)
        && request.resource.data.createdAt is timestamp;
    }

    function isValidString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isValidNumber(value, minVal, maxVal) {
      return value is number && value >= minVal && value <= maxVal;
    }

    function hasField(data, field) {
      return field in data;
    }

    function placeCorrectionOk() {
      return request.resource.data.keys().hasOnly(['hidden', 'name', 'lat', 'lng', 'updatedAt'])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
        && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 1, 120))
        && (
          (!('lat' in request.resource.data) && !('lng' in request.resource.data))
          || (
            isValidNumber(request.resource.data.lat, 7.7, 9.5)
            && isValidNumber(request.resource.data.lng, 99.1, 100.5)
          )
        );
    }

    function placeAddedOk() {
      return request.resource.data.keys().hasOnly(['type', 'name', 'category', 'tambon', 'lat', 'lng', 'hidden', 'updatedAt'])
        && request.resource.data.keys().hasAll(['type', 'name', 'category', 'tambon', 'lat', 'lng', 'updatedAt'])
        && request.resource.data.type == 'added'
        && isValidString(request.resource.data.name, 1, 120)
        && request.resource.data.category in ['r', 'f', 'c', 'm', 't', 'h', 's', 'w', 'g', 'b', 'e', 'o', 'x', 'l', 'p', 'y', 'i', 'k', 'v']
        && request.resource.data.tambon in ['กรุงชิง', 'กรุงหยัน', 'กลาย', 'กะทูน', 'กะปาง', 'กะเปียด', 'กะหรอ', 'การะเกด', 'กำแพงเซา', 'กำโลน', 'กุแหระ', 'เกาะขันธ์', 'เกาะทวด', 'เกาะเพชร', 'แก้วแสน', 'ขนอม', 'ขนาบนาก', 'ขอนหาด', 'ขุนทะเล', 'เขาแก้ว', 'เขาขาว', 'เขาน้อย', 'เขาพระ', 'เขาพระทอง', 'เขาพระบาท', 'เขาพังไกร', 'เขาโร', 'คลองกระบือ', 'คลองน้อย', 'คลองเส', 'คลัง', 'ควนกรด', 'ควนกลาง', 'ควนเกย', 'ควนชะลิก', 'ควนชุม', 'ควนทอง', 'ควนพัง', 'ควนหนองคว้า', 'ควนหนองหงษ์', 'เคร็ง', 'จันดี', 'ฉลอง', 'ฉวาง', 'ชะมาย', 'ชะเมา', 'ชะอวด', 'ช้างกลาง', 'ช้างซ้าย', 'เชียรเขา', 'เชียรใหญ่', 'ไชยมนตรี', 'ดอนตรอ', 'ดอนตะโก', 'ดุสิต', 'ตลิ่งชัน', 'ถ้ำพรรณรา', 'ถ้ำใหญ่', 'ทรายขาว', 'ท้องเนียน', 'ท้องลำเจียก', 'ทอนหงส์', 'ท่าขนาน', 'ท่าขึ้น', 'ทางพูน', 'ท่างิ้ว', 'ท่าซอม', 'ท่าซัก', 'ท่าดี', 'ท่าประจะ', 'ท่าพยา', 'ท้ายสำเภา', 'ท่ายาง', 'ท่าเรือ', 'ท่าไร่', 'ท่าวัง', 'ท่าศาลา', 'ท่าเสม็ด', 'ที่วัง', 'ทุ่งปรัง', 'ทุ่งโพธิ์', 'ทุ่งสง', 'ทุ่งสัง', 'ทุ่งใส', 'ทุ่งใหญ่', 'เทพราช', 'ไทยบุรี', 'นบพิตำ', 'นากะชะ', 'นาเขลียง', 'นาเคียน', 'นางหลง', 'นาทราย', 'นาบอน', 'นาพรุ', 'นาโพธิ์', 'นาไม้ไผ่', 'นาเรียง', 'นาแว', 'นาสาร', 'นาหมอบุญ', 'นาหลวงเสน', 'นาเหรง', 'น้ำตก', 'ในเมือง', 'บางขัน', 'บางจาก', 'บางตะพง', 'บางนบ', 'บางพระ', 'บางรูป', 'บางศาลา', 'บ้านกลาง', 'บ้านเกาะ', 'บ้านควนมุด', 'บ้านชะอวด', 'บ้านตูล', 'บ้านนิคม', 'บ้านเนิน', 'บ้านเพิง', 'บ้านราม', 'บ้านลำนาว', 'บ้านใหม่', 'ปริก', 'ปากนคร', 'ปากพนัง', 'ปากพนังฝั่งตะวันตก', 'ปากพนังฝั่งตะวันออก', 'ปากพูน', 'ปากแพรก', 'ป่าระกำ', 'เปลี่ยน', 'พรหมโลก', 'พิปูน', 'โพธิ์ทอง', 'โพธิ์เสด็จ', 'มะม่วงสองต้น', 'แม่เจ้าอยู่หัว', 'โมคลาน', 'ไม้เรียง', 'ยางค้อม', 'ร่อนพิบูลย์', 'รามแก้ว', 'ละอาย', 'ลานสกา', 'วังหิน', 'วังอ่าง', 'สระแก้ว', 'สวนขัน', 'สวนหลวง', 'สามตำบล', 'สิชล', 'สี่ขีด', 'เสาธง', 'เสาเภา', 'เสือหึง', 'ไสหมาก', 'ไสหร้า', 'หนองหงส์', 'หน้าสตน', 'หลักช้าง', 'ห้วยปริก', 'หัวตะพาน', 'หัวไทร', 'หินตก', 'หูล่อง', 'แหลม', 'แหลมตะลุมพุก', 'อินคีรี']
        && isValidNumber(request.resource.data.lat, 7.7, 9.5)
        && isValidNumber(request.resource.data.lng, 99.1, 100.5)
        && request.resource.data.updatedAt is timestamp
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool);
    }

    function placeOverrideOk() {
      return placeCorrectionOk() || placeAddedOk();
    }

    function noRider(data) {
      return data.get('riderId', null) == null || data.get('riderId', '') == '';
    }

    function moneyFrozen() {
      return unchanged('fare')
        && unchanged('total')
        && unchanged('foodTotal')
        && unchanged('itemsTotal')
        && unchanged('subtotal')
        && unchanged('netTotal')
        && unchanged('discountTotal')
        && unchanged('cashTip')
        && unchanged('items')
        && unchanged('riderIncome')
        && unchanged('riderOwe')
        && unchanged('riderPaid')
        && unchanged('gpTotal')
        && unchanged('gpRider')
        && unchanged('gpPlatform')
        && unchanged('chargedTotal')
        && unchanged('partnerShop')
        && unchanged('shopDisclaimerAccepted');
    }

    function identityFrozen() {
      return unchanged('userId') && unchanged('merchantId') && unchanged('type');
    }

    function orderType() {
      return resource.data.get('type', '');
    }

    // Only food from a verified partner. createOrder sets partnerShop.
    function needsKitchen() {
      return orderType() == 'food' && resource.data.partnerShop == true;
    }

    function foodIsReady() {
      return resource.data.get('foodReady', false) == true
        || (hasField(resource.data, 'readyAt') && resource.data.readyAt != null)
        || resource.data.status == 'ready';
    }

    function shopSlipAttached() {
      return (
          resource.data.get('riderSlipToShop', '') is string
          && resource.data.get('riderSlipToShop', '').size() > 0
        )
        || (
          resource.data.get('riderSlipUrl', '') is string
          && resource.data.get('riderSlipUrl', '').size() > 0
        );
    }

    function isOrderMerchant() {
      return isMerchant() && resource.data.get('merchantId', '') == myUid();
    }

    function isAssignedRider() {
      return isRiderActor() && resource.data.get('riderId', '') == myUid();
    }

    function isOrderCustomer() {
      return isAuth() && resource.data.get('userId', '') == myUid();
    }

    // New payment-flow fields are customer-owned. Confirmation of the order
    // is separate from customerPaid/customerPaidAt.
    function customerOrderConfirmationOk() {
      return isOrderCustomer()
        && resource.data.status == 'accepted'
        && request.resource.data.status == resource.data.status
        && identityFrozen()
        && onlyChanged(['customerOrderConfirmed', 'customerOrderConfirmedAt'])
        && request.resource.data.customerOrderConfirmed == true
        && request.resource.data.customerOrderConfirmedAt is timestamp;
    }

    // Upload proof while the order remains picked_up. The following payment
    // transition may then set customerPaid/customerPaidAt.
    function customerSlipUploadOk(orderId) {
      return isOrderCustomer()
        && resource.data.status == 'picked_up'
        && request.resource.data.status == resource.data.status
        && identityFrozen()
        && onlyChanged(['customerSlipUrl', 'customerSlipPath', 'customerSlipUploadedAt'])
        && request.resource.data.customerSlipUrl is string
        && request.resource.data.customerSlipUrl.size() > 0
        && request.resource.data.customerSlipUrl.size() <= 2000
        && request.resource.data.customerSlipPath is string
        && request.resource.data.customerSlipPath.matches(
          '^slips/customers/' + myUid() + '/' + orderId + '/[A-Za-z0-9_.-]+$'
        )
        && request.resource.data.customerSlipUploadedAt is timestamp;
    }

    function customerSlipAlreadyAttached(orderId) {
      return resource.data.get('customerSlipUrl', '') is string
        && resource.data.get('customerSlipUrl', '').size() > 0
        && resource.data.get('customerSlipPath', '') is string
        && resource.data.get('customerSlipPath', '').matches(
          '^slips/customers/' + myUid() + '/' + orderId + '/[A-Za-z0-9_.-]+$'
        )
        && resource.data.get('customerSlipUploadedAt', null) is timestamp;
    }

    // Only the assigned rider may reject a customer proof. The rider cannot
    // change payment state, ownership, or the uploaded file in this action.
    function riderSlipRejectionOk() {
      return isAssignedRider()
        && resource.data.status == 'picked_up'
        && resource.data.get('customerPaidAt', null) == null
        && resource.data.get('customerSlipUrl', '') is string
        && resource.data.get('customerSlipUrl', '').size() > 0
        && request.resource.data.status == resource.data.status
        && identityFrozen()
        && unchanged('riderId')
        && onlyChanged([
          'customerSlipStatus', 'customerSlipRejectionReason',
          'customerSlipRejectedAt', 'customerSlipRejectedBy'
        ])
        && request.resource.data.customerSlipStatus == 'rejected'
        && isValidString(request.resource.data.customerSlipRejectionReason, 1, 300)
        && request.resource.data.customerSlipRejectedAt is timestamp
        && request.resource.data.customerSlipRejectedBy == myUid();
    }

    // A rejected proof may be replaced only by the order owner. Revision must
    // increase exactly by one, and the new path must remain order-scoped.
    function customerSlipResubmissionOk(orderId) {
      return isOrderCustomer()
        && resource.data.status == 'picked_up'
        && resource.data.get('customerSlipStatus', '') == 'rejected'
        && request.resource.data.status == resource.data.status
        && identityFrozen()
        && onlyChanged([
          'customerSlipUrl', 'customerSlipPath', 'customerSlipUploadedAt',
          'customerSlipStatus', 'customerSlipRevision'
        ])
        && request.resource.data.customerSlipUrl is string
        && request.resource.data.customerSlipUrl.size() > 0
        && request.resource.data.customerSlipUrl.size() <= 2000
        && request.resource.data.customerSlipPath is string
        && request.resource.data.customerSlipPath.matches(
          '^slips/customers/' + myUid() + '/' + orderId + '/[A-Za-z0-9_.-]+$'
        )
        && request.resource.data.customerSlipUploadedAt is timestamp
        && request.resource.data.customerSlipStatus == 'pending'
        && request.resource.data.customerSlipRevision is int
        && request.resource.data.customerSlipRevision
          == resource.data.get('customerSlipRevision', 1) + 1;
    }

    function canReadOrder() {
      return isAdmin()
        || (isAuth() && (
          resource.data.get('userId', '') == myUid()
          || resource.data.get('merchantId', '') == myUid()
          || resource.data.get('riderId', '') == myUid()
        ));
    }

    // Open-job reads are separate allows. One OR that mixes "any cooking
    // order" with "searching only when it is not food" is treated as the
    // union of those statuses, so a query of searching+cooking still returns
    // food the shop has not accepted. Each allow below is exactly one query.

    function noDispatchControl(data) {
      return data.get('dispatchState', '') == ''
        && data.get('dispatchOfferRiderId', '') == ''
        && data.get('dispatchOfferId', '') == ''
        && data.get('dispatchMode', '') == ''
        && data.get('dispatchCounted', false) != true;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function chatParticipantOn(data) {
      return data.get('userId', '') == myUid()
        || data.get('riderId', '') == myUid()
        || data.get('merchantId', '') == myUid();
    }

    function blankId(value) {
      return (value == null || value == '') ? '' : value;
    }

    function orderParty(orderId, field) {
      return isAuth()
        && exists(orderPath(orderId))
        && blankId(get(orderPath(orderId)).data.get(field, '')) == myUid();
    }

    function chatParty(chatId, field) {
      return isAuth()
        && exists(chatPath(chatId))
        && blankId(get(chatPath(chatId)).data.get(field, '')) == myUid();
    }

    function isOrderParty(orderId) {
      return orderParty(orderId, 'userId')
        || orderParty(orderId, 'riderId')
        || orderParty(orderId, 'merchantId');
    }

    function chatIdsFollowOrder(chatId) {
      return exists(orderPath(chatId))
        && blankId(request.resource.data.get('userId', '')) == blankId(get(orderPath(chatId)).data.get('userId', ''))
        && blankId(request.resource.data.get('riderId', '')) == blankId(get(orderPath(chatId)).data.get('riderId', ''))
        && blankId(request.resource.data.get('merchantId', '')) == blankId(get(orderPath(chatId)).data.get('merchantId', ''));
    }

    function messageOk() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'senderId', 'senderRole', 'senderName', 'text', 'imageUrl', 'imagePath', 'createdAt', 'systemMessage',
          'automated', 'automationKey'
        ])
        && data.keys().hasAll(['senderId', 'senderRole', 'createdAt'])
        && data.senderId is string
        && data.senderId == myUid()
        && data.senderRole in ['user', 'rider', 'merchant', 'admin']
        && data.createdAt is timestamp
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 120))
        && (!('text' in data) || (data.text is string && data.text.size() <= 2000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000))
        && (!('imagePath' in data) || (data.imagePath is string && data.imagePath.size() <= 400))
        && (!('systemMessage' in data) || data.systemMessage is bool)
        && (!('automated' in data) || data.automated is bool)
        && (!('automationKey' in data) || (data.automationKey is string && data.automationKey.size() > 0 && data.automationKey.size() <= 40))
        && (
          (('text' in data) && (data.text is string) && data.text.size() > 0)
          || (('imageUrl' in data) && (data.imageUrl is string) && data.imageUrl.size() > 0)
        );
    }

    function messageFrom(chatId, role, field) {
      return request.resource.data.senderRole == role
        && (orderParty(chatId, field) || chatParty(chatId, field));
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function callPath(orderId, callId) {
      return /databases/$(database)/documents/orders/$(orderId)/calls/$(callId);
    }

    // Customer, assigned rider, or the shop on this order. Admin may read.
    function isCallParty(orderId) {
      let data = get(orderPath(orderId)).data;
      return isAdmin() || (
        isAuth()
        && exists(orderPath(orderId))
        && (
          data.get('userId', '') == myUid()
          || (data.get('riderId', '') != '' && data.get('riderId', '') == myUid())
          || (data.get('merchantId', '') != '' && data.get('merchantId', '') == myUid())
        )
      );
    }

    function uidHasCallRole(data, user, party) {
      return (party == 'customer' && data.get('userId', '') == user)
        || (party == 'rider' && data.get('riderId', '') != '' && data.get('riderId', '') == user)
        || (party == 'merchant' && data.get('merchantId', '') != '' && data.get('merchantId', '') == user);
    }

    function callCreateOk(orderId) {
      let data = get(orderPath(orderId)).data;
      let caller = request.resource.data.callerUid;
      let callee = request.resource.data.calleeUid;
      let callerRole = request.resource.data.callerRole;
      let calleeRole = request.resource.data.calleeRole;
      return isAuth()
        && exists(orderPath(orderId))
        && caller == myUid()
        && caller != callee
        && callerRole in ['customer', 'rider', 'merchant']
        && calleeRole in ['customer', 'rider', 'merchant']
        && callerRole != calleeRole
        && uidHasCallRole(data, caller, callerRole)
        && uidHasCallRole(data, callee, calleeRole)
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'ringing'
        && request.resource.data.createdAt is timestamp
        && isValidString(request.resource.data.callerName, 1, 80)
        && isValidString(request.resource.data.calleeName, 1, 80)
        && request.resource.data.keys().hasOnly([
          'orderId', 'callerUid', 'callerRole', 'calleeUid', 'calleeRole',
          'callerName', 'calleeName', 'status', 'createdAt'
        ]);
    }

    function callIdentityFrozen() {
      return unchanged('orderId')
        && unchanged('callerUid')
        && unchanged('callerRole')
        && unchanged('calleeUid')
        && unchanged('calleeRole')
        && unchanged('callerName')
        && unchanged('calleeName')
        && unchanged('createdAt');
    }

    function callStatusOk() {
      let prev = resource.data.status;
      let next = request.resource.data.status;
      let caller = resource.data.callerUid == myUid();
      let callee = resource.data.calleeUid == myUid();
      return (prev == 'ringing' && next == 'active' && callee && request.resource.data.answeredAt is timestamp)
        || (prev == 'ringing' && next == 'declined' && callee)
        || (prev == 'ringing' && next == 'missed' && (caller || callee))
        || (prev == 'ringing' && next == 'cancelled' && caller)
        || (prev == 'active' && next == 'ended' && (caller || callee));
    }

    function isCallMember(orderId, callId) {
      return isAuth()
        && exists(callPath(orderId, callId))
        && (
          get(callPath(orderId, callId)).data.get('callerUid', '') == myUid()
          || get(callPath(orderId, callId)).data.get('calleeUid', '') == myUid()
        );
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || (isAuth() && myUid() == adminId);
      allow create: if isAuth()
        && myUid() == adminId
        && request.resource.data.role == 'pending'
        && isValidString(request.resource.data.get('email', ''), 3, 200);
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isAuth() && myUid() == userId);
      allow create: if isAuth()
        && myUid() == userId
        && request.resource.data.role in ['user', 'merchant', 'rider', 'admin']
        && (request.resource.data.role != 'admin' || request.resource.data.isPending == true);
      allow update: if isAdmin()
        || (
          isAuth()
          && myUid() == userId
          && unchanged('role')
          && unchanged('isPending')
        );
      allow delete: if isAdmin() || (isAuth() && myUid() == userId);
    }

    match /merchants/{merchantId} {
      // Public list is where('verified','==',true). Do not also require isOpen:
      // that query does not filter isOpen, so the list would be rejected.
      allow read: if resource.data.get('verified', false) == true || isAuth();

      allow create: if isAuth()
        && myUid() == merchantId
        && merchantCreateOk();

      allow update: if isAdmin()
        || (
          isAuth()
          && myUid() == merchantId
          && unchanged('verified')
          && unchanged('ratingAvg')
          && unchanged('ratingCount')
          && unchanged('gpPaid')
          && unchanged('merchantId')
          && unchanged('gpPending')
          && unchanged('gpHistory')
          && merchantProfileUpdateOk()
        );

      // Merchant deletion is an admin/server action. Client-side deletion
      // would orphan menus and historical orders.
      allow delete: if isAdmin();
    }

    match /riders/{riderId} {
      // Rider documents contain FCM tokens, QR paths and earnings. They are
      // not a public directory; customers receive only order-scoped fields.
      allow read: if isAdmin() || (isAuth() && myUid() == riderId);
      allow create: if isAuth()
        && myUid() == riderId
        && request.resource.data.verified == false
        && request.resource.data.get('riderId', myUid()) == myUid();
      allow update: if isAdmin()
        || (
          isAuth()
          && myUid() == riderId
          && unchanged('verified')
          && unchanged('riderId')
          && unchanged('trustScore')
          && unchanged('offersAccepted')
          && unchanged('offersTotal')
          && unchanged('activeJobCount')
          && unchanged('idleSince')
          && unchanged('totalIncome')
          && unchanged('totalJobs')
          && riderProfileUpdateOk()
        );
      allow delete: if isAdmin();
    }

    match /menus/{menuId} {
      // Logged-out shop page queries merchantId == id (and doc-id in).
      // A get() of the parent merchant cannot be proven on that query.
      allow read: if true;
      allow create: if isMerchant()
        && request.resource.data.merchantId == myUid()
        && isValidNumber(request.resource.data.price, 0, 100000);
      allow update: if isMerchant()
        && resource.data.merchantId == myUid()
        && request.resource.data.merchantId == myUid()
        && isValidNumber(request.resource.data.price, 0, 100000);
      allow delete: if isMerchant() && resource.data.merchantId == myUid();
    }

    match /orders/{orderId} {
      allow read: if canReadOrder();
      // Shop accepted: cooking/ready, nobody assigned yet. Food and any other type.
      allow read: if isVerifiedRider()
        && resource.data.riderId == null
        && resource.data.status in ['cooking', 'ready'];
      // No kitchen. Ride, express, and shopping are offered from searching.
      allow read: if isVerifiedRider()
        && resource.data.riderId == null
        && resource.data.type in ['ride', 'express', 'shopping']
        && resource.data.status in ['searching', 'pending'];
      // Directory / phone food. partnerShop false is its own query so a
      // partner order still waiting on the shop is not in the same list.
      allow read: if isVerifiedRider()
        && resource.data.riderId == null
        && resource.data.type == 'food'
        && resource.data.partnerShop == false
        && resource.data.status in ['searching', 'pending'];

      // Fare and total are written only by createOrder. Rules cannot
      // recompute the kilometre fee, so any client-set fare is a mismatch.
      allow create: if false;

      allow update: if moneyFrozen() && (
        // [A] customer cancel while still waiting for the shop
        (
          isOrderCustomer()
          && resource.data.status in ['searching', 'pending']
          && request.resource.data.status == 'cancelled'
          && cancelFieldsOk('customer')
          && onlyChanged(['status', 'cancelledAt', 'cancelledBy', 'cancelReason'])
        )
        // Customer-owned transitions are evaluated before the larger
        // rider/merchant state machine. This preserves the same permissions
        // while preventing the Emulator from walking every later branch for
        // a simple slip/confirmation update.
        || customerOrderConfirmationOk()
        || customerSlipUploadOk(orderId)
        || customerSlipResubmissionOk(orderId)
        || (
          isOrderCustomer()
          && resource.data.status == 'picked_up'
          && request.resource.data.status == 'customer_paid'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'customerPaid', 'customerPaidAt'])
        )
        || (
          isOrderCustomer()
          && resource.data.status in ['done', 'delivered']
          && request.resource.data.rated == true
          && unchanged('status')
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['rated', 'ratedAt'])
        )
        || riderSlipRejectionOk()
        // [C] rider pickup — kitchen orders only after the shop marked ready
        || (
          isAssignedRider()
          && request.resource.data.status == 'picked_up'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'pickedUpAt', 'foodImage', 'foodImagePath', 'riderSlipToShop', 'riderSlipToShopPath', 'riderPaidShopAt', 'riderSlipUrl', 'riderSlipPath'])
          && (
            (resource.data.status == 'accepted' && (!needsKitchen() || foodIsReady()))
            || (resource.data.status == 'ready' && !noRider(resource.data))
          )
        )
        || (
          isAssignedRider()
          && needsKitchen()
          && resource.data.status in ['picked_up', 'customer_paid']
          && request.resource.data.status == resource.data.status
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['riderSlipToShop', 'riderSlipToShopPath', 'riderPaidShopAt', 'riderSlipUrl', 'riderSlipPath'])
          && request.resource.data.riderSlipToShop is string
          && request.resource.data.riderSlipToShop.size() > 0
          && request.resource.data.riderSlipToShop.size() <= 2000
          && request.resource.data.riderPaidShopAt is timestamp
        )
        || (
          isAssignedRider()
          && resource.data.status in ['picked_up', 'customer_paid']
          && request.resource.data.status == 'on_the_way'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'onTheWayAt'])
          && (!needsKitchen() || shopSlipAttached())
        )
        || (
          isAssignedRider()
          && resource.data.status == 'picked_up'
          && request.resource.data.status == 'customer_paid'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'customerPaid', 'customerPaidAt'])
        )
        // Completion payout is completeOrder only. Clients cannot set
        // riderIncome, riderOwe, or riderPaid, or flip status to done.
        // [D] rider cancel
        || (
          isAssignedRider()
          && resource.data.status in ['accepted', 'picked_up', 'customer_paid', 'on_the_way']
          && request.resource.data.status == 'cancelled'
          && cancelFieldsOk('rider')
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'cancelledAt', 'cancelledBy', 'cancelReason'])
        )
        || (
          isAssignedRider()
          && resource.data.status == 'on_the_way'
          && unchanged('status')
          && unchanged('riderId')
          && identityFrozen()
          && onlyChanged(['riderNearCustomerAt', 'riderNearCustomerChatAt', 'riderArrivedCustomerChatAt'])
          && changedToTimestamp('riderNearCustomerAt')
          && changedToTimestamp('riderNearCustomerChatAt')
          && changedToTimestamp('riderArrivedCustomerChatAt')
        )
        // [E] merchant accept / cancel / mark ready (including after rider accepted)
        || (
          isOrderMerchant()
          && resource.data.status in ['searching', 'pending']
          && request.resource.data.status == 'cooking'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'cookingAt', 'prepMinutes', 'code', 'deliveryCode', 'codeCreatedAt'])
          && request.resource.data.cookingAt is timestamp
          && changedToString('code', 7, 7)
          && changedToString('deliveryCode', 4, 4)
          && changedToTimestamp('codeCreatedAt')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['code'])
            || request.resource.data.code.matches('^OD-[0-9]{4}$'))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryCode'])
            || request.resource.data.deliveryCode.matches('^[0-9]{4}$'))
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['prepMinutes'])
            || request.resource.data.prepMinutes in [10, 15, 20]
          )
        )
        || (
          isOrderMerchant()
          && resource.data.status in ['searching', 'pending', 'cooking']
          && request.resource.data.status == 'cancelled'
          && cancelFieldsOk('merchant')
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'cancelledAt', 'cancelledBy', 'cancelReason'])
        )
        || (
          isOrderMerchant()
          && request.resource.data.foodReady == true
          && identityFrozen()
          && unchanged('riderId')
          && resource.data.status in ['cooking', 'ready', 'accepted']
          && onlyChanged(['foodReady', 'readyAt', 'status'])
          && request.resource.data.readyAt is timestamp
          && (
            request.resource.data.status == resource.data.status
            || (
              noRider(resource.data)
              && request.resource.data.status == 'ready'
              && resource.data.status in ['cooking', 'ready']
            )
          )
        )
        // [H] admin / boss — cannot rewrite prices or totals
        || (
          isAdmin()
          && identityFrozen()
        )
      );

      allow delete: if isAdmin();

      // Server-owned offers. Riders can read their own row. Nobody writes from the client.
      match /dispatchOffers/{offerId} {
        allow read: if isAuth() && resource.data.get('riderId', '') == myUid();
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }

      // Voice-call signaling. Publish this file or these calls stay permission-denied.
      match /calls/{callId} {
        allow read: if isCallParty(orderId);
        allow create: if callCreateOk(orderId);
        allow update: if isCallParty(orderId)
          && callIdentityFrozen()
          && callStatusOk()
          && onlyChanged(['status', 'answeredAt', 'endedBy'])
          && (
            !('endedBy' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.endedBy == myUid()
          );
        allow delete: if isAdmin();

        match /offer/{signalId} {
          allow read: if isCallParty(orderId);
          allow create: if isCallMember(orderId, callId)
            && get(callPath(orderId, callId)).data.callerUid == myUid()
            && request.resource.data.keys().hasOnly(['type', 'sdp'])
            && request.resource.data.type == 'offer'
            && isValidString(request.resource.data.sdp, 20, 20000);
          allow update, delete: if false;
        }

        match /answer/{signalId} {
          allow read: if isCallParty(orderId);
          allow create: if isCallMember(orderId, callId)
            && get(callPath(orderId, callId)).data.calleeUid == myUid()
            && request.resource.data.keys().hasOnly(['type', 'sdp'])
            && request.resource.data.type == 'answer'
            && isValidString(request.resource.data.sdp, 20, 20000);
          allow update, delete: if false;
        }

        match /ice/{signalId} {
          allow read: if isCallParty(orderId);
          allow create: if isCallMember(orderId, callId)
            && request.resource.data.fromUid == myUid()
            && request.resource.data.keys().hasOnly(['fromUid', 'candidate', 'sdpMid', 'sdpMLineIndex'])
            && isValidString(request.resource.data.candidate, 2, 2000)
            && isValidString(request.resource.data.sdpMid, 1, 20)
            && request.resource.data.sdpMLineIndex is int
            && request.resource.data.sdpMLineIndex >= 0
            && request.resource.data.sdpMLineIndex <= 50;
          allow update, delete: if false;
        }
      }
    }

    match /ratings/{ratingId} {
      allow read: if isAuth();
      allow create: if ratingCreateOk(ratingId);
      allow update, delete: if isAdmin();
    }

    match /gps_riders/{riderId} {
      // Raw GPS is for the rider and dispatch backend only. Customer tracking
      // is served from orders/{orderId}/tracking/current below.
      allow read: if isAdmin() || (isAuth() && myUid() == riderId);
      allow create, update: if isVerifiedRider() && myUid() == riderId
        && gpsWriteOk(riderId);
      allow delete: if isAdmin() || (isVerifiedRider() && myUid() == riderId);
    }

    match /rider_locations/{locId} {
      allow read: if isAdmin() || (isAuth() && myUid() == locId);
      allow create, update: if isVerifiedRider() && myUid() == locId;
      allow delete: if isAdmin() || (isVerifiedRider() && myUid() == locId);
    }

    match /orders/{orderId}/tracking/{trackingId} {
      allow read: if isAdmin() || isOrderParty(orderId);
      allow write: if false;
    }

    match /chats/{chatId} {
      // A missing chat used to deny the get(), so the app never created it
      // and the following message write was permission-denied.
      allow read: if resource == null
        ? isAuth()
        : (
          isOrderParty(chatId)
          || (isAuth() && chatParticipantOn(resource.data))
          || isAdmin()
        );
      allow create: if isAuth() && (
        (isOrderParty(chatId) && chatIdsFollowOrder(chatId))
        || (chatParticipantOn(request.resource.data) && !exists(orderPath(chatId)))
      );
      allow update: if (
          isOrderParty(chatId)
          && chatIdsFollowOrder(chatId)
          && onlyChanged([
            'userId', 'riderId', 'merchantId', 'userName', 'riderName', 'merchantName',
            'lastMessage', 'lastSenderId', 'lastMessageAt', 'orderId', 'unreadAdmin'
          ])
        )
        || (
          isAuth()
          && resource != null
          && chatParticipantOn(resource.data)
          && unchanged('userId')
          && unchanged('riderId')
          && unchanged('merchantId')
        )
        || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOrderParty(chatId)
          || chatParty(chatId, 'userId')
          || chatParty(chatId, 'riderId')
          || chatParty(chatId, 'merchantId')
          || isAdmin();
        allow create: if messageOk() && (
          messageFrom(chatId, 'user', 'userId')
          || messageFrom(chatId, 'rider', 'riderId')
          || messageFrom(chatId, 'merchant', 'merchantId')
          || (request.resource.data.senderRole == 'admin' && isAdmin())
        );
        allow update, delete: if isAdmin();
      }
    }

    match /gp_transfers/{transferId} {
      allow read: if isAdmin() || (isAuth() && resource.data.merchantId == myUid());
      allow create: if isMerchant()
        && request.resource.data.merchantId == myUid()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'merchantId', 'merchantName', 'amount', 'slipUrl', 'slipPath',
          'note', 'status', 'roundLabel', 'createdAt'
        ])
        && isValidString(request.resource.data.get('merchantName', ''), 1, 120)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000
        && request.resource.data.slipPath is string
        && request.resource.data.slipPath.matches('^gp_slips/' + myUid() + '/[A-Za-z0-9_.-]+$')
        && request.resource.data.get('slipUrl', '') is string
        && request.resource.data.get('slipUrl', '').size() <= 2000
        && request.resource.data.get('note', '') is string
        && request.resource.data.get('note', '').size() <= 300
        && request.resource.data.get('roundLabel', '') is string
        && request.resource.data.get('roundLabel', '').size() <= 80
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    match /rider_payouts/{payoutId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Consent Events are created by the trusted Cloud Function only.
    // Clients may read their own history for privacy/DSAR screens, but cannot
    // forge subjectRef/timestamps or mutate append-only audit evidence.
    // One-job lock. Only Cloud Functions (admin SDK) may read or write it.
    match /rider_locks/{riderId} {
      allow read, write: if false;
    }

    match /consent_events/{eventId} {
      allow read: if isAdmin() || (isAuth() && resource.data.subjectRef == myUid());
      allow create, update, delete: if false;
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // OSM corrections (doc id n123 / w456) or admin-added places (type 'added').
    // Publish this rules file before hide, edit, add, or delete will succeed.
    match /placeOverrides/{placeId} {
      allow read: if true;
      allow create, update: if isAdmin() && placeOverrideOk();
      allow delete: if isAdmin();
    }

    match /config/dispatch {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Collection-group listener: riders/{query riderId == me}. Direct field
    // equality is what the query checker can prove. .get() is not.
    match /{path=**}/dispatchOffers/{offerId} {
      allow read: if isAuth() && resource.data.riderId == myUid();
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
