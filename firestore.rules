rules_version = '2';
// ChauatGo — based on console rules v3.8.4 (project chauat-go-b9841).
// Deltas from v3.8.4:
//   * merchants: unauthenticated read only when verified == true (shop list query)
//   * menus: public read (list query is merchantId only; cannot prove parent verified)
//   * orders update [B]: parentheses fixed; food accept only from cooking/ready;
//     ride/express/shopping (no kitchen) may still accept from searching/pending
//   * orders update [E]: merchant may set foodReady + readyAt after rider accepted,
//     without changing status; status becomes ready only while no rider is assigned
//   * orders update [C]: picked_up only after food is ready when the order needs a kitchen
//   * isAdmin also covers boss role active/super, users.role admin (not pending),
//     and the three master emails — a pending admins doc cannot self-promote
//   * placeOverrides: anyone can read; only isAdmin() can write.
//     OSM corrections: hidden / name / lat / lng.
//     Admin-added places: type 'added' plus name, category, tambon, lat, lng.
//   * orders/{orderId}/calls: only that order's customer, rider, or shop
//     (or admin) may read signaling. A participant may create a call as
//     themselves and write offer, answer, and ICE for that call.
//   * orders read: customer, shop, assigned rider, admin/boss, or a rider
//     reading an unassigned searching/pending/cooking/ready order.
//   * auto dispatch: riders cannot write dispatch fields or dispatchOffers.
//     While config/dispatch.mode is auto, a rider may claim an order when it
//     is offered to them alone, or when orders/{id}/dispatchOffers/{their uid}
//     is still pending (broadcast). config/dispatch is admin-write, auth-read.
//   * chats/messages: the order's customer, rider, or shop may read and send
//     even when the chat doc has no userId/riderId (or does not exist yet).
//     A missing chat can be read as "not found" by any signed-in user.
//     Message keys are only senderId, senderRole, senderName, text, imageUrl,
//     imagePath, createdAt, systemMessage — no phone fields.
// Every other collection keeps the v3.8.4 access shape.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    // Phone sign-in stores email as null. .lower() on null denies the whole rule.
    function authEmail() {
      return isAuth() && request.auth.token.get('email', '') is string
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    function isMasterEmail() {
      return authEmail() in [
        'adminchauatgo@gmail.com',
        'admin@chauatgo.com',
        'chauatgo@gmail.com'
      ];
    }

    function isBossActive() {
      return isAuth()
        && exists(/databases/$(database)/documents/admins/$(myUid()))
        && get(/databases/$(database)/documents/admins/$(myUid())).data.get('role', '') in ['active', 'super'];
    }

    function isAdminByRole() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && get(/databases/$(database)/documents/users/$(myUid())).data.get('role', '') == 'admin'
        && get(/databases/$(database)/documents/users/$(myUid())).data.get('isPending', false) != true;
    }

    // v3.8.4 named this exists(admins/{uid}). Pending signups must not inherit it.
    function isAdmin() {
      return isMasterEmail() || isBossActive() || isAdminByRole();
    }

    function isMerchant() {
      return isAuth() && exists(/databases/$(database)/documents/merchants/$(myUid()));
    }

    function isRider() {
      return isAuth() && exists(/databases/$(database)/documents/riders/$(myUid()));
    }

    function isRiderByRole() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && get(/databases/$(database)/documents/users/$(myUid())).data.role == 'rider';
    }

    function isRiderActor() {
      return isRider() || isRiderByRole();
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function isValidString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isValidNumber(value, minVal, maxVal) {
      return value is number && value >= minVal && value <= maxVal;
    }

    function hasField(data, field) {
      return field in data;
    }

    function placeCorrectionOk() {
      return request.resource.data.keys().hasOnly(['hidden', 'name', 'lat', 'lng', 'updatedAt'])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
        && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 1, 120))
        && (
          (!('lat' in request.resource.data) && !('lng' in request.resource.data))
          || (
            isValidNumber(request.resource.data.lat, 7.5, 8.5)
            && isValidNumber(request.resource.data.lng, 99.4, 100.5)
          )
        );
    }

    function placeAddedOk() {
      return request.resource.data.keys().hasOnly(['type', 'name', 'category', 'tambon', 'lat', 'lng', 'hidden', 'updatedAt'])
        && request.resource.data.keys().hasAll(['type', 'name', 'category', 'tambon', 'lat', 'lng', 'updatedAt'])
        && request.resource.data.type == 'added'
        && isValidString(request.resource.data.name, 1, 120)
        && request.resource.data.category in ['r', 'f', 'c', 'm', 't', 'h', 's', 'w', 'g', 'b', 'e', 'o', 'x', 'l', 'p', 'y', 'i', 'k', 'v']
        && request.resource.data.tambon in ['ชะอวด', 'ท่าเสม็ด', 'ท่าประจะ', 'เคร็ง', 'วังอ่าง', 'บ้านตูล', 'ขอนหาด', 'เกาะขันธ์', 'ควนหนองหงษ์', 'เขาพระทอง', 'นางหลง']
        && isValidNumber(request.resource.data.lat, 7.5, 8.5)
        && isValidNumber(request.resource.data.lng, 99.4, 100.5)
        && request.resource.data.updatedAt is timestamp
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool);
    }

    function placeOverrideOk() {
      return placeCorrectionOk() || placeAddedOk();
    }

    function noRider(data) {
      return data.get('riderId', null) == null || data.get('riderId', '') == '';
    }

    function moneyFrozen() {
      return unchanged('fare')
        && unchanged('total')
        && unchanged('foodTotal')
        && unchanged('itemsTotal')
        && unchanged('subtotal')
        && unchanged('netTotal')
        && unchanged('discountTotal')
        && unchanged('cashTip')
        && unchanged('items');
    }

    function identityFrozen() {
      return unchanged('userId') && unchanged('merchantId') && unchanged('type');
    }

    function orderType() {
      return resource.data.get('type', '');
    }

    // Food, or a legacy doc that has a shop and is not ride/express/shopping.
    function needsKitchen() {
      return orderType() == 'food'
        || (
          orderType() != 'ride'
          && orderType() != 'express'
          && orderType() != 'shopping'
          && resource.data.get('merchantId', '') != ''
        );
    }

    function foodIsReady() {
      return resource.data.get('foodReady', false) == true
        || (hasField(resource.data, 'readyAt') && resource.data.readyAt != null)
        || resource.data.status == 'ready';
    }

    function isOrderMerchant() {
      return isMerchant() && resource.data.get('merchantId', '') == myUid();
    }

    function isAssignedRider() {
      return isRiderActor() && resource.data.get('riderId', '') == myUid();
    }

    function isOrderCustomer() {
      return isAuth() && resource.data.get('userId', '') == myUid();
    }

    function autoDispatchOn() {
      return exists(/databases/$(database)/documents/config/dispatch)
        && get(/databases/$(database)/documents/config/dispatch).data.get('mode', 'manual') == 'auto';
    }

    function myPendingOffer(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)/dispatchOffers/$(myUid()));
    }

    function riderMayTakeOpenJob(orderId) {
      return !autoDispatchOn()
        || resource.data.get('dispatchOfferRiderId', '') == myUid()
        || (
          exists(/databases/$(database)/documents/orders/$(orderId)/dispatchOffers/$(myUid()))
          && myPendingOffer(orderId).data.get('riderId', '') == myUid()
          && myPendingOffer(orderId).data.get('status', '') == 'pending'
        );
    }

    function canReadOrder() {
      return isAdmin()
        || (isAuth() && (
          resource.data.get('userId', '') == myUid()
          || resource.data.get('merchantId', '') == myUid()
          || resource.data.get('riderId', '') == myUid()
        ))
        || (isRiderActor() && resource.data.status in ['searching', 'pending', 'cooking', 'ready']);
    }

    function noDispatchControl(data) {
      return data.get('dispatchState', '') == ''
        && data.get('dispatchOfferRiderId', '') == ''
        && data.get('dispatchOfferId', '') == ''
        && data.get('dispatchMode', '') == ''
        && data.get('dispatchCounted', false) != true;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function chatParticipantOn(data) {
      return data.get('userId', '') == myUid()
        || data.get('riderId', '') == myUid()
        || data.get('merchantId', '') == myUid();
    }

    function blankId(value) {
      return (value == null || value == '') ? '' : value;
    }

    function orderParty(orderId, field) {
      return isAuth()
        && exists(orderPath(orderId))
        && blankId(get(orderPath(orderId)).data.get(field, '')) == myUid();
    }

    function chatParty(chatId, field) {
      return isAuth()
        && exists(chatPath(chatId))
        && blankId(get(chatPath(chatId)).data.get(field, '')) == myUid();
    }

    function isOrderParty(orderId) {
      return orderParty(orderId, 'userId')
        || orderParty(orderId, 'riderId')
        || orderParty(orderId, 'merchantId');
    }

    function chatIdsFollowOrder(chatId) {
      return exists(orderPath(chatId))
        && blankId(request.resource.data.get('userId', '')) == blankId(get(orderPath(chatId)).data.get('userId', ''))
        && blankId(request.resource.data.get('riderId', '')) == blankId(get(orderPath(chatId)).data.get('riderId', ''))
        && blankId(request.resource.data.get('merchantId', '')) == blankId(get(orderPath(chatId)).data.get('merchantId', ''));
    }

    function messageOk() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'senderId', 'senderRole', 'senderName', 'text', 'imageUrl', 'imagePath', 'createdAt', 'systemMessage'
        ])
        && data.keys().hasAll(['senderId', 'senderRole', 'createdAt'])
        && data.senderId is string
        && data.senderId == myUid()
        && data.senderRole in ['user', 'rider', 'merchant', 'admin']
        && data.createdAt is timestamp
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 120))
        && (!('text' in data) || (data.text is string && data.text.size() <= 2000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000))
        && (!('imagePath' in data) || (data.imagePath is string && data.imagePath.size() <= 400))
        && (!('systemMessage' in data) || data.systemMessage is bool)
        && (
          (('text' in data) && (data.text is string) && data.text.size() > 0)
          || (('imageUrl' in data) && (data.imageUrl is string) && data.imageUrl.size() > 0)
        );
    }

    function messageFrom(chatId, role, field) {
      return request.resource.data.senderRole == role
        && (orderParty(chatId, field) || chatParty(chatId, field));
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function callPath(orderId, callId) {
      return /databases/$(database)/documents/orders/$(orderId)/calls/$(callId);
    }

    // Customer, assigned rider, or the shop on this order. Admin may read.
    function isCallParty(orderId) {
      let data = get(orderPath(orderId)).data;
      return isAdmin() || (
        isAuth()
        && exists(orderPath(orderId))
        && (
          data.get('userId', '') == myUid()
          || (data.get('riderId', '') != '' && data.get('riderId', '') == myUid())
          || (data.get('merchantId', '') != '' && data.get('merchantId', '') == myUid())
        )
      );
    }

    function uidHasCallRole(data, user, party) {
      return (party == 'customer' && data.get('userId', '') == user)
        || (party == 'rider' && data.get('riderId', '') != '' && data.get('riderId', '') == user)
        || (party == 'merchant' && data.get('merchantId', '') != '' && data.get('merchantId', '') == user);
    }

    function callCreateOk(orderId) {
      let data = get(orderPath(orderId)).data;
      let caller = request.resource.data.callerUid;
      let callee = request.resource.data.calleeUid;
      let callerRole = request.resource.data.callerRole;
      let calleeRole = request.resource.data.calleeRole;
      return isAuth()
        && exists(orderPath(orderId))
        && caller == myUid()
        && caller != callee
        && callerRole in ['customer', 'rider', 'merchant']
        && calleeRole in ['customer', 'rider', 'merchant']
        && callerRole != calleeRole
        && uidHasCallRole(data, caller, callerRole)
        && uidHasCallRole(data, callee, calleeRole)
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'ringing'
        && request.resource.data.createdAt is timestamp
        && isValidString(request.resource.data.callerName, 1, 80)
        && isValidString(request.resource.data.calleeName, 1, 80)
        && request.resource.data.keys().hasOnly([
          'orderId', 'callerUid', 'callerRole', 'calleeUid', 'calleeRole',
          'callerName', 'calleeName', 'status', 'createdAt'
        ]);
    }

    function callIdentityFrozen() {
      return unchanged('orderId')
        && unchanged('callerUid')
        && unchanged('callerRole')
        && unchanged('calleeUid')
        && unchanged('calleeRole')
        && unchanged('callerName')
        && unchanged('calleeName')
        && unchanged('createdAt');
    }

    function callStatusOk() {
      let prev = resource.data.status;
      let next = request.resource.data.status;
      let caller = resource.data.callerUid == myUid();
      let callee = resource.data.calleeUid == myUid();
      return (prev == 'ringing' && next == 'active' && callee && request.resource.data.answeredAt is timestamp)
        || (prev == 'ringing' && next == 'declined' && callee)
        || (prev == 'ringing' && next == 'missed' && (caller || callee))
        || (prev == 'ringing' && next == 'cancelled' && caller)
        || (prev == 'active' && next == 'ended' && (caller || callee));
    }

    function isCallMember(orderId, callId) {
      return isAuth()
        && exists(callPath(orderId, callId))
        && (
          get(callPath(orderId, callId)).data.get('callerUid', '') == myUid()
          || get(callPath(orderId, callId)).data.get('calleeUid', '') == myUid()
        );
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || (isAuth() && myUid() == adminId);
      allow create: if isAuth()
        && myUid() == adminId
        && request.resource.data.role == 'pending'
        && isValidString(request.resource.data.get('email', ''), 3, 200);
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isAuth() && myUid() == userId);
      allow create: if isAuth()
        && myUid() == userId
        && request.resource.data.role in ['user', 'merchant', 'rider', 'admin']
        && (request.resource.data.role != 'admin' || request.resource.data.isPending == true);
      allow update: if isAdmin()
        || (
          isAuth()
          && myUid() == userId
          && unchanged('role')
          && unchanged('isPending')
        );
      allow delete: if isAdmin() || (isAuth() && myUid() == userId);
    }

    match /merchants/{merchantId} {
      // Public list is where('verified','==',true). Do not also require isOpen:
      // that query does not filter isOpen, so the list would be rejected.
      allow read: if resource.data.get('verified', false) == true || isAuth();

      allow create: if isAuth()
        && myUid() == merchantId
        && request.resource.data.verified == false
        && request.resource.data.merchantId == myUid();

      allow update: if isAdmin()
        || (
          isAuth()
          && myUid() == merchantId
          && unchanged('verified')
          && unchanged('ratingAvg')
          && unchanged('ratingCount')
          && unchanged('gpPaid')
          && unchanged('merchantId')
        );

      allow delete: if isAdmin() || (isAuth() && myUid() == merchantId);
    }

    match /riders/{riderId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && myUid() == riderId
        && request.resource.data.verified == false
        && request.resource.data.get('riderId', myUid()) == myUid();
      allow update: if isAdmin()
        || (
          isAuth()
          && myUid() == riderId
          && unchanged('verified')
          && unchanged('riderId')
          && unchanged('trustScore')
          && unchanged('offersAccepted')
          && unchanged('offersTotal')
          && unchanged('activeJobCount')
          && unchanged('idleSince')
        );
      allow delete: if isAdmin();
    }

    match /menus/{menuId} {
      // Logged-out shop page queries merchantId == id (and doc-id in).
      // A get() of the parent merchant cannot be proven on that query.
      allow read: if true;
      allow create: if isMerchant()
        && request.resource.data.merchantId == myUid()
        && isValidNumber(request.resource.data.price, 0, 100000);
      allow update: if isMerchant()
        && resource.data.merchantId == myUid()
        && request.resource.data.merchantId == myUid()
        && isValidNumber(request.resource.data.price, 0, 100000);
      allow delete: if isMerchant() && resource.data.merchantId == myUid();
    }

    match /orders/{orderId} {
      allow read: if canReadOrder();

      allow create: if isAuth()
        && request.resource.data.userId == myUid()
        && request.resource.data.status in ['searching', 'pending']
        && request.resource.data.type in ['food', 'ride', 'express', 'shopping']
        && isValidNumber(request.resource.data.total, 0, 100000)
        && noRider(request.resource.data)
        && noDispatchControl(request.resource.data)
        && request.resource.data.get('foodReady', false) != true;

      allow update: if moneyFrozen() && (
        // [A] customer cancel while still waiting for the shop
        (
          isOrderCustomer()
          && resource.data.status in ['searching', 'pending']
          && request.resource.data.status == 'cancelled'
          && onlyChanged(['status', 'cancelledAt', 'cancelledBy', 'cancelReason'])
        )
        // [B] rider accept — fully parenthesized (v3.8.4 bound || tighter than &&)
        || (
          isRiderActor()
          && noRider(resource.data)
          && request.resource.data.riderId == myUid()
          && request.resource.data.status == 'accepted'
          && identityFrozen()
          && riderMayTakeOpenJob(orderId)
          && onlyChanged(['riderId', 'riderName', 'riderPhone', 'status', 'acceptedAt'])
          && (
            (needsKitchen() && resource.data.status in ['cooking', 'ready'])
            || (!needsKitchen() && resource.data.status in ['searching', 'pending', 'cooking', 'ready'])
          )
        )
        // [C] rider pickup — kitchen orders only after the shop marked ready
        || (
          isAssignedRider()
          && request.resource.data.status == 'picked_up'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'pickedUpAt', 'foodImage', 'foodImagePath', 'riderSlipToShop', 'riderSlipToShopPath', 'riderPaidShopAt', 'riderSlipUrl', 'riderSlipPath'])
          && (
            (resource.data.status == 'accepted' && (!needsKitchen() || foodIsReady()))
            || (resource.data.status == 'ready' && !noRider(resource.data))
          )
        )
        || (
          isAssignedRider()
          && resource.data.status in ['picked_up', 'customer_paid']
          && request.resource.data.status == 'on_the_way'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'onTheWayAt'])
        )
        || (
          isAssignedRider()
          && resource.data.status == 'picked_up'
          && request.resource.data.status == 'customer_paid'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'customerPaid', 'customerPaidAt'])
        )
        || (
          isAssignedRider()
          && resource.data.status == 'on_the_way'
          && request.resource.data.status in ['delivered', 'done']
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'doneAt', 'deliveredAt', 'riderIncome', 'riderOwe', 'riderPaid'])
          && isValidNumber(request.resource.data.get('riderIncome', 0), 0, 100000)
          && isValidNumber(request.resource.data.get('riderOwe', 0), 0, 100000)
        )
        // [D] rider cancel
        || (
          isAssignedRider()
          && resource.data.status in ['accepted', 'picked_up', 'customer_paid', 'on_the_way']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == 'rider'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'cancelledAt', 'cancelledBy', 'cancelReason'])
        )
        || (
          isAssignedRider()
          && unchanged('status')
          && unchanged('riderId')
          && identityFrozen()
          && onlyChanged(['riderNearCustomerAt'])
        )
        // [E] merchant accept / cancel / mark ready (including after rider accepted)
        || (
          isOrderMerchant()
          && resource.data.status in ['searching', 'pending']
          && request.resource.data.status == 'cooking'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'cookingAt', 'prepMinutes', 'code', 'deliveryCode', 'codeCreatedAt'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['prepMinutes'])
            || request.resource.data.prepMinutes in [10, 15, 20]
          )
        )
        || (
          isOrderMerchant()
          && resource.data.status in ['searching', 'pending', 'cooking']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == 'merchant'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'cancelledAt', 'cancelledBy', 'cancelReason'])
        )
        || (
          isOrderMerchant()
          && request.resource.data.foodReady == true
          && identityFrozen()
          && unchanged('riderId')
          && resource.data.status in ['cooking', 'ready', 'accepted']
          && onlyChanged(['foodReady', 'readyAt', 'status'])
          && (
            request.resource.data.status == resource.data.status
            || (
              noRider(resource.data)
              && request.resource.data.status == 'ready'
              && resource.data.status in ['cooking', 'ready']
            )
          )
        )
        // [F] customer confirms payment
        || (
          isOrderCustomer()
          && resource.data.status == 'picked_up'
          && request.resource.data.status == 'customer_paid'
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['status', 'customerPaid', 'customerPaidAt'])
        )
        // [G] customer rating flag
        || (
          isOrderCustomer()
          && resource.data.status in ['done', 'delivered']
          && request.resource.data.rated == true
          && unchanged('status')
          && identityFrozen()
          && unchanged('riderId')
          && onlyChanged(['rated', 'ratedAt'])
        )
        // [H] admin / boss — cannot rewrite prices or totals
        || (
          isAdmin()
          && identityFrozen()
        )
      );

      allow delete: if isAdmin();

      // Server-owned offers. Riders can read their own row. Nobody writes from the client.
      match /dispatchOffers/{offerId} {
        allow read: if isAuth() && resource.data.get('riderId', '') == myUid();
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }

      // Voice-call signaling. Publish this file or these calls stay permission-denied.
      match /calls/{callId} {
        allow read: if isCallParty(orderId);
        allow create: if callCreateOk(orderId);
        allow update: if isCallParty(orderId)
          && callIdentityFrozen()
          && callStatusOk()
          && onlyChanged(['status', 'answeredAt', 'endedBy'])
          && (
            !('endedBy' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.endedBy == myUid()
          );
        allow delete: if isAdmin();

        match /offer/{signalId} {
          allow read: if isCallParty(orderId);
          allow create: if isCallMember(orderId, callId)
            && get(callPath(orderId, callId)).data.callerUid == myUid()
            && request.resource.data.keys().hasOnly(['type', 'sdp'])
            && request.resource.data.type == 'offer'
            && isValidString(request.resource.data.sdp, 20, 20000);
          allow update, delete: if false;
        }

        match /answer/{signalId} {
          allow read: if isCallParty(orderId);
          allow create: if isCallMember(orderId, callId)
            && get(callPath(orderId, callId)).data.calleeUid == myUid()
            && request.resource.data.keys().hasOnly(['type', 'sdp'])
            && request.resource.data.type == 'answer'
            && isValidString(request.resource.data.sdp, 20, 20000);
          allow update, delete: if false;
        }

        match /ice/{signalId} {
          allow read: if isCallParty(orderId);
          allow create: if isCallMember(orderId, callId)
            && request.resource.data.fromUid == myUid()
            && request.resource.data.keys().hasOnly(['fromUid', 'candidate', 'sdpMid', 'sdpMLineIndex'])
            && isValidString(request.resource.data.candidate, 2, 2000)
            && isValidString(request.resource.data.sdpMid, 1, 20)
            && request.resource.data.sdpMLineIndex is int
            && request.resource.data.sdpMLineIndex >= 0
            && request.resource.data.sdpMLineIndex <= 50;
          allow update, delete: if false;
        }
      }
    }

    match /ratings/{ratingId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == myUid()
        && request.resource.data.orderId == ratingId
        && isValidNumber(request.resource.data.get('riderRating', 0), 0, 5)
        && isValidNumber(request.resource.data.get('merchantRating', 0), 0, 5);
      allow update, delete: if isAdmin();
    }

    match /gps_riders/{riderId} {
      allow read: if isAuth();
      allow create, update: if isRiderActor() && myUid() == riderId
        && request.resource.data.riderId == myUid();
      allow delete: if isAdmin() || (isRiderActor() && myUid() == riderId);
    }

    match /rider_locations/{locId} {
      allow read: if isAuth();
      allow create, update: if isRiderActor() && myUid() == locId;
      allow delete: if isAdmin() || (isRiderActor() && myUid() == locId);
    }

    match /chats/{chatId} {
      // A missing chat used to deny the get(), so the app never created it
      // and the following message write was permission-denied.
      allow read: if resource == null
        ? isAuth()
        : (
          isOrderParty(chatId)
          || (isAuth() && chatParticipantOn(resource.data))
          || isAdmin()
        );
      allow create: if isAuth() && (
        (isOrderParty(chatId) && chatIdsFollowOrder(chatId))
        || (chatParticipantOn(request.resource.data) && !exists(orderPath(chatId)))
      );
      allow update: if (
          isOrderParty(chatId)
          && chatIdsFollowOrder(chatId)
          && onlyChanged([
            'userId', 'riderId', 'merchantId', 'userName', 'riderName', 'merchantName',
            'lastMessage', 'lastSenderId', 'lastMessageAt', 'orderId', 'unreadAdmin'
          ])
        )
        || (
          isAuth()
          && resource != null
          && chatParticipantOn(resource.data)
          && unchanged('userId')
          && unchanged('riderId')
          && unchanged('merchantId')
        )
        || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOrderParty(chatId)
          || chatParty(chatId, 'userId')
          || chatParty(chatId, 'riderId')
          || chatParty(chatId, 'merchantId')
          || isAdmin();
        allow create: if messageOk() && (
          messageFrom(chatId, 'user', 'userId')
          || messageFrom(chatId, 'rider', 'riderId')
          || messageFrom(chatId, 'merchant', 'merchantId')
          || (request.resource.data.senderRole == 'admin' && isAdmin())
        );
        allow update, delete: if isAdmin();
      }
    }

    match /gp_transfers/{transferId} {
      allow read: if isAdmin() || (isAuth() && resource.data.merchantId == myUid());
      allow create: if isMerchant()
        && request.resource.data.merchantId == myUid()
        && request.resource.data.status == 'pending'
        && isValidNumber(request.resource.data.amount, 0, 1000000);
      allow update, delete: if isAdmin();
    }

    match /rider_payouts/{payoutId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // OSM corrections (doc id n123 / w456) or admin-added places (type 'added').
    // Publish this rules file before hide, edit, add, or delete will succeed.
    match /placeOverrides/{placeId} {
      allow read: if true;
      allow create, update: if isAdmin() && placeOverrideOk();
      allow delete: if isAdmin();
    }

    match /config/dispatch {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Collection-group listener: riders/{query riderId == me}. Direct field
    // equality is what the query checker can prove. .get() is not.
    match /{path=**}/dispatchOffers/{offerId} {
      allow read: if isAuth() && resource.data.riderId == myUid();
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
